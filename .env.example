# ===========================================================================
# PrinceNsamba AI - example environment file
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored and docker-ignored:
# secrets must never be committed.
# Priority: any variable already exported by the process wins over this file, but an
# exported *empty* value (FOOT=) counts as unset and this file applies — set the
# refusing value explicitly (COOKIE_SECURE=0) rather than leaving it blank.
#   cp .env.example .env && chmod 600 .env
# Generate secrets with:  openssl rand -hex 32
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# JSON (true) for log shippers, plain text for humans.
LOG_JSON=1
# All mutable state (database, uploads, generated secrets) lives here.
DATA_DIR=./data
# Auto-generation of missing secrets into DATA_DIR. Allowed outside production.
# In production the default is OFF: a missing secret is an error, not a surprise
# (a regenerated secret silently invalidates every session after a restart).
# Set to 1 only if you deliberately accept that on a managed first boot.
SECRET_ALLOW_GENERATED=0
# Set to 1 to silence the "HOST=127.0.0.1 is unreachable from a proxy" hint.
FORCE_LOCALHOST_WARNING=0

# --- Secrets (REQUIRED in production; auto-generated into data/ if absent) --
# Used to sign/HMAC session + refresh tokens. Rotating it invalidates all
# active sessions on purpose.
SESSION_SECRET=
# Used to sign password-reset tokens and CSRF bindings.
STATE_SECRET=
# Leave empty to let the container generate a strong secret and store it in the
# data volume, never printed. Set it explicitly for real deploys.
# Le mode du fichier de secret generate est fixe a 0600 : il n'est pas
# configurable, pour qu'aucun deploiement ne puisse l'assouplir par erreur.

# --- Database --------------------------------------------------------------
DB_PATH=./data/app.db
DB_BUSY_TIMEOUT_MS=5000

# --- First administrator bootstrap (NO hardcoded credentials) --------------
BOOTSTRAP_ADMIN=1
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
# Empty => a strong random password is generated and written ONCE to
# data/bootstrap-admin-password (0600) and must be changed at first login.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Password policy -------------------------------------------------------
PASSWORD_MIN_LENGTH=12
# Argon2id cost parameters (tune up on production hardware).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32

# --- Sessions / cookies ----------------------------------------------------
SESSION_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=auto
COOKIE_SAMESITE=strict
# "__Host-" is applied automatically when COOKIE_SECURE=1 (requires HTTPS).
COOKIE_PREFIX=
CSRF_PROTECTION=1
SECURE_PROXY=0
# Embedding this app in an <iframe> is refused by default (X-Frame-Options: DENY
# and CSP frame-ancestors 'none'). Only if a specific console must embed it, list
# those origins — with scheme — to relax both headers. Use a wildcard only for a
# preview platform you do not control (e.g. https://*.example.app); a fixed origin
# is always preferable. Anything malformed or without a scheme refuses to start.
CSP_FRAME_ANCESTORS=

# --- Brute force protection ------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
ACCOUNT_LOCK_MINUTES=30
# Global request budgets per client fingerprint (1/min). Behind a reverse
# proxy, set SECURE_PROXY=1 so the limit applies to the real client IP.
API_RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=30
URL_RATE_LIMIT_PER_MIN=20

# --- Frontend de developpement (Vite) --------------------------------------
# Cible du proxy du serveur de dev (`npm run dev`) vers l'API. Inutile en
# production : l'API sert elle-meme le build de `npm run build`.
API_URL=http://127.0.0.1:3000

# --- Uploads / files -------------------------------------------------------
# Taille maximale d'un fichier téléversé (rejetée avant écriture disque).
MAX_UPLOAD_MB=10
# Quota cumulé par utilisateur, contrôlé à chaque téléversement.
MAX_QUOTA_MB=500
UPLOAD_DIR=./data/uploads
# 1 = la signature binaire du fichier doit correspondre à son extension.
FILE_SCAN_ENFORCE_MAGIC=1

# --- URL analysis (SSRF policy) -------------------------------------------
URL_FETCH_TIMEOUT_MS=5000
URL_MAX_BYTES=2000000
URL_MAX_REDIRECTS=2
# Keep at 0 unless you really want the agent to reach internal networks.
URL_ALLOW_PRIVATE_HOSTS=0
URL_ALLOWED_PORTS=80,443,8080,8443

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins. Never use * together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Framing (iframe) -------------------------------------------------------
# Empty (default) = the app refuses to be framed: CSP frame-ancestors 'none'
# and X-Frame-Options: DENY. Set a space- or comma-separated list of FULL
# origins (scheme required) only when an embedding is deliberate, e.g. an
# internal viewer or a sandbox preview: CSP_FRAME_ANCESTORS=https://app.internal
# Never '*' - the loader refuses it. Setting this also removes X-Frame-Options,
# because that legacy header would otherwise silently override the CSP policy.

# --- Content limits --------------------------------------------------------
JSON_BODY_LIMIT=1mb

# --- Optional dev-only conveniences (must stay 0 in production) ------------
DISABLE_AUTH_FOR_TESTS=0

# --- Lu par Docker Compose et par les outils (jamais par le serveur) ---
# Publication du port : 127.0.0.1 par défaut, le TLS se termine sur un reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=3000
# Cibles du smoke test (scripts/smoke-test.js). SMOKE_PASSWORD_FILE permet de lire le
# mot de passe temporaire écrit par le bootstrap sans le taper dans un shell.
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_PASSWORD_FILE=
SMOKE_NEW_PASSWORD=

# --- Agent vidéo (phase A : ingestion + sondage d'en-tête) ---
# L'ingestion reste éteinte tant que le réglage « video.enabled » n'est pas activé
# par un administrateur (Configuration). Les limites ci-dessous sont des plafonds.
VIDEO_MAX_UPLOAD_MB=64
VIDEO_MAX_DURATION_S=3600
VIDEO_PROBE_WINDOW_KIB=512
VIDEO_PROBE_TIMEOUT_MS=10000
VIDEO_USE_FFPROBE=1
FFPROBE_PATH=ffprobe
VIDEO_QUARANTINE_ON_FAILURE=1
# File d'exécution : le worker est un processus séparé (`npm run worker`).
# VIDEO_WORKER_KINDS = kinds traités par CE processus (liste fermée : probe, transcode,
# transcribe, thumbnail, moderation). VIDEO_WORKER_POLL_MS = cadence de la boucle.
# VIDEO_WORKER_IN_PROCESS ne sert qu'aux tests : faire traiter des médias dans le
# processus web est exactement ce que cette architecture interdit.
VIDEO_WORKER_KINDS=probe
VIDEO_WORKER_POLL_MS=1000
VIDEO_WORKER_IN_PROCESS=0
# Outillage media (phase C) : le worker seul execute ces binaires, jamais le processus web.
# FFMPEG_PATH sert aussi de verrou : si le binaire est absent ou non executable, la tache est
# refusee sous un nom (VIDEO_TOOL_UNAVAILABLE) au lieu d'etre marquee reussie.
FFMPEG_PATH=ffmpeg
VIDEO_TOOL_TIMEOUT_MS=30000
